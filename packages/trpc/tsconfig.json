{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": false,
    "paths": {
      "@/*": ["./src/*"],
      "@sanotalk/db/*": ["../../packages/db/src/*"]
