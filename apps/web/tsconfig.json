{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sanotalk/trpc/*": ["../../packages/trpc/src/*"],
      "@sanotalk/db/*": ["../../packages/db/src/*"],
      "@sanotalk/config/*": ["../../packages/config/src/*"]
    },
  }
  ,
  "references": [
    { "path": "../../packages/trpc"},
    { "path": "../../packages/db"}
  ],
}
