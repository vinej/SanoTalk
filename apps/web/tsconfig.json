{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sanotalk/trpc/*": ["../../packages/trpc/src/*"],
      "@sanotalk/db/*": ["../../packages/db/src/*"]
    },
  }
  ,
  "include": ["src", "src/locales/**/*.json"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/trpc"},
    { "path": "../../packages/db"}
  ],
}
