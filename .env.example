# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://sanotalk:sanotalk@localhost:5432/sanotalk

# ─────────────────────────────────────────────
# AUTH — Better Auth
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=your-super-secret-32-char-minimum
BETTER_AUTH_URL=http://localhost:3001

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@sanotalk.app

# ─────────────────────────────────────────────
# LIVEKIT
# ─────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─────────────────────────────────────────────
# DEEPGRAM
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key

# ─────────────────────────────────────────────
# MINIO (S3-compatible)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sanotalk

# ─────────────────────────────────────────────
# OPENREPLAY
# ─────────────────────────────────────────────
VITE_OPENREPLAY_PROJECT_KEY=your-openreplay-project-key
VITE_OPENREPLAY_INGEST_POINT=https://your-openreplay-instance.com/ingest

# ─────────────────────────────────────────────
# GRAFANA / LOKI
# ─────────────────────────────────────────────
LOKI_URL=http://localhost:3100
GRAFANA_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
PORT=3001
