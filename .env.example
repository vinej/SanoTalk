# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/sanotalk
DB_USER=postgres
DB_PASSWORD=<strong-random-password>

# ─────────────────────────────────────────────
# AUTH — Better Auth
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=your-super-secret-32-char-minimum
BETTER_AUTH_URL=http://localhost:3001

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────
# TESTING
# Set TESTING=yes to redirect ALL outgoing emails to TESTING_EMAIL.
# ─────────────────────────────────────────────
TESTING=no
TESTING_EMAIL=your-test-email@example.com

# ─────────────────────────────────────────────
# LIVEKIT
# ─────────────────────────────────────────────
LIVEKIT_URL=wss://<your-livekit-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# ─────────────────────────────────────────────
# DEEPGRAM
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ─────────────────────────────────────────────
# ENCRYPTION — AES-256-GCM for sensitive health data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
ENCRYPTION_KEY=<generate-64-char-hex-string>
# To rotate: set ENCRYPTION_KEY_V2 to a new 64-char hex string and bump
# CURRENT_KEY_VERSION in packages/trpc/src/lib/crypto.ts to 2.
# Existing data encrypted with v1 will still decrypt using ENCRYPTION_KEY.
# ENCRYPTION_KEY_V2=<new-64-char-hex-string>

# ─────────────────────────────────────────────
# AI / LLM
# Supported providers: anthropic, openai, ollama, groq, openrouter, gemini, github
# ─────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OpenAI (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Ollama (only needed if AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq (only needed if AI_PROVIDER=groq)
# Get a key at https://console.groq.com/keys
# Tool calling is supported on llama-3.3-70b-versatile and llama-3.1-8b-instant.
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (only needed if AI_PROVIDER=openrouter)
# Get a key at https://openrouter.ai/keys. Model IDs are slugs like
# "anthropic/claude-sonnet-4.5", "openai/gpt-4o", "meta-llama/llama-3.3-70b-instruct".
# Tool-calling support varies per route — set USE_TOOLS=no for models that don't.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://sanotalk.example.com
# OPENROUTER_TITLE=SanoTalk

# Gemini / Google Generative AI (only needed if AI_PROVIDER=gemini)
# Get a key at https://aistudio.google.com/apikey
# Tool calling supported on gemini-2.5-pro, gemini-2.5-flash, and 1.5 family.
# GEMINI_API_KEY=...

# GitHub Models (only needed if AI_PROVIDER=github)
# Public OpenAI-compatible endpoint hosting GPT-4o, Llama, Phi, Mistral, etc.
# Auth uses a GitHub PAT with the "models:read" scope (https://github.com/settings/tokens).
# Free tier has tight rate limits — for production use, route through Azure AI.
# Catalog and exact model IDs: https://github.com/marketplace/models
# GITHUB_TOKEN=ghp_...
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Model overrides (optional — sensible defaults per provider)
# AI_MODEL_LARGE=claude-sonnet-4-6
# AI_MODEL_SMALL=claude-haiku-4-5-20251001

# Set USE_TOOLS=no when running against a model that doesn't support native
# tool/function calling (Gemma, MedGemma on Ollama). Agents will drop their
# tool definitions (web search, drug lookup, nutrition) and rely on the base
# model only. Defaults to yes — leave as-is for Anthropic, OpenAI, or
# tool-capable Ollama models (llama3.1+, qwen2.5, mistral-nemo).
# USE_TOOLS=yes

# Web search for non-Anthropic providers (Anthropic has built-in search)
# TAVILY_API_KEY=tvly-...

# USDA FoodData Central API key (optional — uses DEMO_KEY if not set, limited to 30 req/hour)
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=your-usda-api-key

# ─────────────────────────────────────────────
# TEST AGENT — local MD docs mode (admin-only chat tester)
# When enabled, the Test AI Agent runs a summarize → route → read pipeline:
#   1. On first use it creates summary_<name>.md next to each source .md file
#      (cached on disk, regenerated only if the source is edited).
#   2. Each user question triggers a "router" LLM call that picks the single
#      most relevant document based on the summaries.
#   3. A second "reader" LLM call answers the question using ONLY the content
#      of the selected file and cites its filename at the end of the reply.
#
# Because only ONE full document is ever loaded per answer, the feature scales
# to dozens of large files on 128K-token models (gemma 3 4B/12B/27B, GPT-4o).
# First-run summary generation against a local Ollama model can take several
# minutes for large folders — subsequent calls are fast.
# ─────────────────────────────────────────────
# TEST_AGENT_DOCS_MODE=true
# TEST_AGENT_DOCS_PATH=C:\gemma4

# Router pipeline depth for docs mode:
#   2 = read summaries of ALL docs, pick the best one, then answer.
#       Simpler, burns more context per call. Use when you have few documents
#       (≲ 30) or when the filenames aren't descriptive enough for step 3.
#   3 = pre-filter by filename to the top 4 candidates, read ONLY those
#       summaries, pick the best one, then answer. (default)
# TEST_STEPS=3

# Route the Test Agent to a DIFFERENT provider than the rest of the app.
# Useful for local testing: the production app can stay on Anthropic (which
# has a 30K input-tokens/min rate limit on Tier 1 that the docs-mode reader
# call easily blows past), while the Test Agent runs against a local Ollama
# model with no rate limit. Only testChatAgent is affected — every other
# agent keeps using the global AI_PROVIDER.
# If TEST_AGENT_MODEL is omitted, the provider's default large model is used.
# Accepts the same values as AI_PROVIDER: anthropic, openai, ollama, groq, openrouter, gemini, github.
# TEST_AGENT_PROVIDER=ollama
# TEST_AGENT_MODEL=gemma3

# ─────────────────────────────────────────────
# MINIO (S3-compatible)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_USER=<your-minio-admin-user>
MINIO_PASSWORD=<strong-random-password>
MINIO_BUCKET=sanotalk

# ─────────────────────────────────────────────
# OPENREPLAY
# ─────────────────────────────────────────────
VITE_OPENREPLAY_ENABLED=false
VITE_OPENREPLAY_PROJECT_KEY=your-openreplay-project-key
VITE_OPENREPLAY_INGEST_POINT=https://your-openreplay-instance.com/ingest

# ─────────────────────────────────────────────
# GRAFANA / LOKI
# ─────────────────────────────────────────────
# The server pushes logs through the loki-proxy nginx sidecar (see
# infra/loki-proxy). LOKI_URL points at the proxy, not Loki directly.
# LOKI_USER / LOKI_PASSWORD are consumed by both the server (basic-auth
# header on each push) and the proxy (generates /tmp/.htpasswd at boot).
LOKI_URL=http://127.0.0.1:3100
LOKI_USER=sanotalk-logs
LOKI_PASSWORD=<change-me-32-char-random>
GRAFANA_ADMIN_PASSWORD=<change-me-strong-random-password>

# ─────────────────────────────────────────────
# TERRA — wearable device aggregator (Garmin / Fitbit / Google Fit / etc.)
# Optional. Set ALL three to enable, or leave all unset to disable.
# Webhook URL to register in the Terra dashboard:
#   https://<your-prod-domain>/api/webhooks/terra
# ─────────────────────────────────────────────
# TERRA_API_KEY=<your-terra-api-key>
# TERRA_DEV_ID=<your-terra-dev-id>
# TERRA_WEBHOOK_SECRET=<your-terra-webhook-secret>
#
# Reconcile-poll tuning (only relevant if Terra is enabled).
# The poll is a credit-burning safety net that catches measurements webhooks
# may have missed. Webhooks alone are usually enough; lower the frequency to
# save credits, or set TERRA_POLL_INTERVAL_MIN=0 to disable it entirely.
#
# Defaults match runReconcilePoll() in apps/server/src/terra/poll.ts:
# TERRA_POLL_INTERVAL_MIN=30      # how often the poll runs (0 = disabled)
# TERRA_POLL_MIN_AGE_MIN=60       # skip a connection if synced more recently than this
# TERRA_POLL_INCLUDE_BODY=true    # fetch /v2/body  (HR / BP / weight / SpO2 / glucose / temp)
# TERRA_POLL_INCLUDE_DAILY=true   # fetch /v2/daily (resting HR avg, SpO2 avg)
# TERRA_POLL_BACKSTOP_DAYS=7      # max days back the sliding window can reach

# ─────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=wss://localhost:3001
PORT=3001
APP_URL=http://localhost:5173
