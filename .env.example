# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/sanotalk
DB_USER=postgres
DB_PASSWORD=<strong-random-password>

# ─────────────────────────────────────────────
# AUTH — Better Auth
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=your-super-secret-32-char-minimum
BETTER_AUTH_URL=http://localhost:3001

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────
# TESTING
# Set TESTING=yes to redirect ALL outgoing emails to TESTING_EMAIL.
# ─────────────────────────────────────────────
TESTING=no
TESTING_EMAIL=your-test-email@example.com

# ─────────────────────────────────────────────
# LIVEKIT
# ─────────────────────────────────────────────
LIVEKIT_URL=wss://<your-livekit-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# ─────────────────────────────────────────────
# DEEPGRAM
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ─────────────────────────────────────────────
# ENCRYPTION — AES-256-GCM for sensitive fields (RAMQ etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
ENCRYPTION_KEY=<generate-64-char-hex-string>

# ─────────────────────────────────────────────
# AI / LLM
# Supported providers: anthropic, openai, ollama
# ─────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OpenAI (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Ollama (only needed if AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Model overrides (optional — sensible defaults per provider)
# AI_MODEL_LARGE=claude-sonnet-4-6
# AI_MODEL_SMALL=claude-haiku-4-5-20251001

# Web search for non-Anthropic providers (Anthropic has built-in search)
# TAVILY_API_KEY=tvly-...

# ─────────────────────────────────────────────
# MINIO (S3-compatible)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USER=minioadmin
MINIO_PASSWORD=<strong-random-password>
MINIO_BUCKET=sanotalk

# ─────────────────────────────────────────────
# OPENREPLAY
# ─────────────────────────────────────────────
VITE_OPENREPLAY_PROJECT_KEY=your-openreplay-project-key
VITE_OPENREPLAY_INGEST_POINT=https://your-openreplay-instance.com/ingest

# ─────────────────────────────────────────────
# GRAFANA / LOKI
# ─────────────────────────────────────────────
LOKI_URL=http://localhost:3100
GRAFANA_ADMIN_PASSWORD=<change-me-strong-random-password>

# ─────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=wss://localhost:3001
PORT=3001
APP_URL=http://localhost:5173
